{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-agent/types/**/*.ts",
    ".next-agent/dev/types/**/*.ts",
    ".next-regions/types/**/*.ts",
    ".next-regions/dev/types/**/*.ts",
    ".next-analysis/types/**/*.ts",
    ".next-analysis/dev/types/**/*.ts",
    "artifacts/maintenance-build-20261004-01/types/**/*.ts",
    "artifacts/maintenance-build-20261004-01/dev/types/**/*.ts",
    "artifacts/maintenance-build-20261004-02/types/**/*.ts",
    "artifacts/maintenance-build-20261004-02/dev/types/**/*.ts",
    "artifacts/maintenance-build-20261004-03/types/**/*.ts",
    "artifacts/maintenance-build-20261004-03/dev/types/**/*.ts",
    "artifacts/bounded-maintenance-build-20261004-01/types/**/*.ts",
    "artifacts/bounded-maintenance-build-20261004-01/dev/types/**/*.ts",
    "artifacts/map-legend-build-20261004-01/types/**/*.ts",
    "artifacts/map-legend-build-20261004-01/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts/**",
    "output/**"
  ]
}
