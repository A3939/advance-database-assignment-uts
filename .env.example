# Template only. Never put a real password in this tracked file.
ARSIA_DB_PASSWORD=REPLACE_WITH_YOUR_OWN_LOCAL_PASSWORD
ARSIA_LOADER_PASSWORD=REPLACE_WITH_A_DIFFERENT_LOADER_PASSWORD
ARSIA_READER_PASSWORD=REPLACE_WITH_A_DIFFERENT_READER_PASSWORD
ARSIA_PROJECT=arsia-yourname
ARSIA_EXECUTOR=REPLACE_WITH_YOUR_NAME
# Run git rev-parse HEAD after selecting the required commit.
ARSIA_REVISION=REPLACE_WITH_FULL_COMMIT
ARSIA_DB_PORT=55432
ARSIA_WEB_PORT=8765
# Optional; only used with compose.official.yaml. Use forward slashes on Windows.
# ARSIA_OFFICIAL_DIR=C:/Users/yourname/arsia-official
